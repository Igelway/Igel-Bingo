# ==========================================================================
#    Velocity
# ==========================================================================
VELOCITY_ONLINE_MODE=true
VELOCITY_FORWARDING_MODE=modern

# Port for the Velocity proxy (default: 25565)
IGELBINGO_PORT=25565

# ==========================================================================
#    Admin
# ==========================================================================
# Comma-separated list of Minecraft usernames with admin privileges
IGELBINGO_ADMINS=

# ==========================================================================
#    Game Server
# ==========================================================================
# Operator usernames for the game server (comma-separated)
IGELBINGO_GAME_OPS=

# itzg environment variables forwarded to the game container.
# All IGELBINGO_GAME_* vars are forwarded as their itzg equivalents.
IGELBINGO_GAME_DIFFICULTY=easy
IGELBINGO_GAME_VIEW_DISTANCE=20
IGELBINGO_GAME_MAX_PLAYERS=500
IGELBINGO_GAME_MEMORY=6G

# Give elytra at game start (true/false)
IGELBINGO_GAME_GIVE_ELYTRA=true

# Use the 1.16/1.16.1 (20w20a–20w27a) piglin bartering loot table (true/false).
# false = vanilla bartering
IGELBINGO_GAME_MODIFIED_LOOTTABLES=true

# Smaller biomes + smoother terrain via worldgen datapack (true/false).
# false = vanilla worldgen. Port of the "Biome Sizes" mod.
IGELBINGO_GAME_SMALL_BIOMES=true

# ==========================================================================
#    Lobby Server
# ==========================================================================
# itzg environment variables forwarded to the lobby container.
IGELBINGO_LOBBY_DIFFICULTY=peaceful
IGELBINGO_LOBBY_VIEW_DISTANCE=10
IGELBINGO_LOBBY_MEMORY=2G

# Auto-start lobby when player joins limbo (true/false)
IGELBINGO_LOBBY_AUTO_START=true

# Auto-stop lobby when game starts (true/false)
IGELBINGO_LOBBY_STOP_ON_GAME=true

# Idle time in seconds before lobby auto-stops (0 = disabled)
IGELBINGO_LOBBY_IDLE_TIMEOUT=300

# ==========================================================================
#    Chunky Pre-generation
# ==========================================================================
# Enable Chunky pre-generation on /ib prepare and /ib start (true/false)
IGELBINGO_CHUNKY_PRELOAD=false

# Chunky radius settings (blocks)
IGELBINGO_CHUNKY_OW_RADIUS=5000
IGELBINGO_CHUNKY_NETHER_RADIUS=2000
IGELBINGO_CHUNKY_END_RADIUS=2000

# ==========================================================================
#    Docker
# ==========================================================================
# Custom Docker images (default: ghcr.io/igelway/igel-bingo-*)
IGELBINGO_VELOCITY_IMAGE=
IGELBINGO_GAMESERVER_IMAGE=

# Pull the game server image before starting a new container (always|missing|never)
IGELBINGO_PULL_GAME_IMAGE=missing

# Data directory for persistent volume mounts
GAME_DATA_DIR=./data

# User/group IDs for container file ownership
PUID=1000
PGID=1000

# ==========================================================================
#    EULA
# ==========================================================================
MINECRAFT_SERVER_EULA=true

# ==========================================================================
#    Compose Profiles
# ==========================================================================
# Use "playit" to enable the playit.gg tunnel
COMPOSE_PROFILES=

# ==========================================================================
#    Resource Pack
# ==========================================================================
IGELBINGO_RESOURCE_PACK=https://raw.githubusercontent.com/Igelway/Igel-Bingo/main/docker/IgelBingo_Resources.zip
# SHA1 must match the ZIP file at the URL above. Recompute on every change:
#   curl -sfL "$IGELBINGO_RESOURCE_PACK" | sha1sum
IGELBINGO_GAME_RESOURCE_PACK_SHA1=36bc7fe83d94398977e3d90b5ab6e1676c1ea17a
