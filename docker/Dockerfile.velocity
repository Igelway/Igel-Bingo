FROM eclipse-temurin:25-jre-jammy

ARG PUID=1000
ARG PGID=1000

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${PGID} minecraft || true && \
    useradd -u ${PUID} -g ${PGID} -m -s /bin/sh minecraft || true

WORKDIR /data

RUN mkdir -p /opt/app-files/plugins

# Download Velocity
RUN curl -o /opt/app-files/velocity.jar -L \
    "https://fill-data.papermc.io/v1/objects/0407642d1ed2883100eb823c2805523f191fa637db1f42ac0ec7ef29cbe455a9/velocity-3.5.0-SNAPSHOT-601.jar"

# Download LuckPerms for Velocity
RUN curl -o /opt/app-files/plugins/LuckPerms-Velocity.jar -L \
    "https://download.luckperms.net/1631/velocity/LuckPerms-Velocity-5.5.42.jar"

# Copy IgelBingo Velocity Plugin
COPY igelbingo-velocity/build/libs/igelbingo-velocity-*.jar /opt/app-files/plugins/

# Copy config templates
COPY docker/defaults/velocity/ /opt/config-template/

# Copy entrypoint
COPY docker/velocity-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN chown -R minecraft:minecraft /opt/app-files /opt/config-template /data

ENV IGELBINGO_DOCKER_MODE=true
EXPOSE 25577

ENTRYPOINT ["/entrypoint.sh"]
